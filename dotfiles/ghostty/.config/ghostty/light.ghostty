# =========================================================
# DimArch OS — Ghostty light profile (override)
# Loaded on top of config.ghostty via:
#   ghostty --config-file=~/.config/ghostty/light.ghostty
#
# Only overrides what changes for a light theme — everything
# else (font, keybinds, behavior) is inherited from the base
# config.ghostty.
# =========================================================

# ---------------------------------------------------------
# Colors — DimArch Sage, light variant
# ---------------------------------------------------------

background = f8f4ea
foreground = 2d3a2e

# Selection
selection-background = bfe0d2
selection-foreground = 2d3a2e

# Cursor
cursor-color = 347658
cursor-text = f8f4ea

# ANSI 16 colors — same hues as the dark palette, recalculated rather than
# inverted: at their dark-surface lightness these accents give ~2.7:1 on cream.
# `bright` tiers are DEEPER than base, not lighter — on a light ground
# brightness costs legibility, so emphasis is carried by contrast (4.6 -> 6.5).
# The background-adjacent slot mirrors to 15, not 0: bright-white is what can
# never be a readable foreground here, while 0 becomes the darkest text.
# Rebuilt 2026-07-26 from colors/palette.json — the previous set had 11 of 13
# colour slots below AA (worst 2.23) and blue duplicating green's hue exactly.
# blue (4/12) shifted from blue to sage-green 2026-07-26, same reasoning
# and darkening ratio as the dark profile's palette 4/12 — see config.ghostty.
# 2026-07-27: 5/13 moved off heather (removed in v3) onto cinnamon, and 6/14
# onto the recut patina. This file was NOT in components.json until then, so
# `palette check` could not see it and the stale values passed unnoticed.
palette = 0=#2d3a2e
palette = 1=#c23838
palette = 2=#347658
palette = 3=#8a6228
palette = 4=#557331
palette = 5=#a95028
palette = 6=#297570
palette = 7=#5a6b5c
palette = 8=#716868
palette = 9=#9f2424
palette = 10=#245d43
palette = 11=#6f4d19
palette = 12=#415b22
palette = 13=#85401f
palette = 14=#205c58
palette = 15=#f7f5f0

# ---------------------------------------------------------
# Window appearance
# ---------------------------------------------------------

# Light background over a dark Hyprland/wallpaper aesthetic reads
# poorly with too much transparency bleeding through — keep this
# profile closer to opaque than the dark profile.
#
# background-blur is a no-op on Hyprland (Ghostty docs: supported only
# on macOS and KDE Plasma/KWin) — actual window blur is Hyprland's own
# compositor-level decoration.blur (~/.config/hypr/modules/decoration.lua,
# size=8/passes=2), identical for both profiles since it's global.
background-opacity = 0.88
