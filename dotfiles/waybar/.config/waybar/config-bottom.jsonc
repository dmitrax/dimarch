// =========================================================
// DimArch OS — Waybar Bottom Panel
// Window taskbar — current workspace only
// =========================================================
{
    "layer": "top",
    "position": "bottom",
    "height": 32,
    "exclusive": true,
    "passthrough": false,
    "output": ["DP-1", "DP-2"],

    "modules-left": [
        "custom/taskbar"
    ],

    "modules-right": [
        "custom/workspace-indicator"
    ],

    // ── Taskbar — window list ──────────────────────────────
    "custom/taskbar": {
        "exec": "~/.config/hypr/scripts/taskbar.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/hypr/scripts/window-picker.sh"
    },
    // ── Workspace indicator ────────────────────────────────
    "custom/workspace-indicator": {
        "exec": "hyprctl activeworkspace -j | python3 -c \"import sys,json; d=json.load(sys.stdin); print('{\\\"text\\\": \\\"ws' + str(d['id']) + ' · ' + str(d['windows']) + '\\\"}')\"",
        "return-type": "json",
        "interval": 1
    }
}
