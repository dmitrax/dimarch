# =========================================================
# DimArch OS — Mako Notification Daemon
# Dark translucent — matches Waybar style
# =========================================================

# Position
anchor=top-right
margin=12
padding=14,16

# Size
width=360
height=200
max-visible=5

# Timing
default-timeout=5000
ignore-timeout=0

# Style
background-color=#16161cCC
text-color=#edeae4
border-color=#7fb89e44
border-radius=12
border-size=1

font=Inter Variable 13

# Icons
icons=1
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=40

# Progress bar (for media notifications)
[urgency=low]
background-color=#16161cBB
border-color=#7fb89e33
default-timeout=4000

[urgency=normal]
background-color=#16161cCC
border-color=#7fb89e44
default-timeout=5000

[urgency=high]
background-color=#2a1a1aDD
border-color=#d96c6cAA
text-color=#edeae4
default-timeout=0
