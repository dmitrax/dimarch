# =========================================================
# DimArch OS — Ghostty light profile (override)
# Loaded on top of config.ghostty via:
#   ghostty --config-file=~/.config/ghostty/light.ghostty
#
# Only overrides what changes for a light theme — everything
# else (font, keybinds, behavior) is inherited from the base
# config.ghostty.
# =========================================================

# ---------------------------------------------------------
# Colors — DimArch Sage, light variant
# ---------------------------------------------------------

background = f4f2ec
foreground = 2a2a30

# Selection
selection-background = bfe0d2
selection-foreground = 2a2a30

# Cursor
cursor-color = 2f7d5e
cursor-text = f4f2ec

# ANSI 16 colors — accents kept close to the dark palette's hue,
# darkened for contrast against a light background. 0/7/8/15
# (the grayscale/background-adjacent slots) are inverted.
palette = 0=#2a2a30
palette = 1=#a85a5a
palette = 2=#3f8a68
palette = 3=#b8843f
palette = 4=#4a72a8
palette = 5=#7a54a0
palette = 6=#3f8f8a
palette = 7=#a8a49c
palette = 8=#6b6b78
palette = 9=#c47a7a
palette = 10=#4fa37c
palette = 11=#cf9a52
palette = 12=#5f89c4
palette = 13=#9070b8
palette = 14=#4fa39e
palette = 15=#f7f5f0

# ---------------------------------------------------------
# Window appearance
# ---------------------------------------------------------

# Light background over a dark Hyprland/wallpaper aesthetic reads
# poorly with heavy blur bleeding through — keep this profile
# closer to opaque instead of the dark profile's 0.88/15.
background-opacity = 0.97
background-blur = 0
