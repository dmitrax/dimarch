#!/usr/bin/env bash
# dimarch-sleep — sleep mode wrapper for DimArch OS
#
# Reads sleep_mode from /etc/dimarch.conf and calls the appropriate
# systemd sleep command. Defaults to 'suspend' if config is missing.
#
# Called by hypridle on idle timeout. Deploy via setup-hibernate.sh
# or manually: install -m 755 dimarch-sleep /usr/local/bin/dimarch-sleep

set -euo pipefail

_conf_get() {
    local section="$1" key="$2" file="${3:-/etc/dimarch.conf}"
    [[ -f "$file" ]] || return 1
    awk -F' *= *' -v s="$section" -v k="$key" '
        /^\[/ { cur = substr($0, 2, length($0)-2) }
        cur==s && $1==k {
            gsub(/[[:space:]]*#.*$/, "", $2)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
            print $2; exit
        }
    ' "$file"
}

DIMARCH_CONF="${DIMARCH_CONF:-/etc/dimarch.conf}"
SLEEP_MODE=$(_conf_get power sleep_mode "$DIMARCH_CONF" 2>/dev/null || true)
SLEEP_MODE="${SLEEP_MODE:-suspend}"

case "$SLEEP_MODE" in
    # systemctl hibernate goes through logind CanHibernate() which returns ENOENT in
    # systemd 261 (cannot verify swap offset from sandbox). Bypass via hibernate.target
    # directly. Requires NOPASSWD sudoers rule (deployed by setup-hibernate.sh).
    hibernate) exec sudo systemctl start hibernate.target ;;
    suspend)   exec systemctl suspend   ;;
    *)
        echo "dimarch-sleep: unknown sleep_mode '${SLEEP_MODE}', falling back to suspend" >&2
        exec systemctl suspend
        ;;
esac
