#!/usr/bin/env bash
# dimarchctl — DimArch OS unified CLI
#
# Usage: dimarchctl <command> [subcommand] [--json]

set -euo pipefail

VERSION="0.1.0"
PHASE="1"
SYS_CONF="/etc/dimarch.conf"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/dimarch/dimarch.conf"

# ─────────────────────────────────────────────────────────────────────────────
#  Config helpers
# ─────────────────────────────────────────────────────────────────────────────

_conf_get() {
    local section="$1" key="$2" file="$3"
    [[ -f "$file" ]] || return 1
    awk -F' *= *' -v s="$section" -v k="$key" '
        /^\[/ { cur = substr($0, 2, length($0)-2) }
        cur==s && $1==k {
            gsub(/[[:space:]]*#.*$/, "", $2)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
            print $2; exit
        }
    ' "$file"
}

_conf_get_merged() {
    local section="$1" key="$2" val=""
    if [[ -f "$USER_CONF" ]]; then
        val=$(_conf_get "$section" "$key" "$USER_CONF" 2>/dev/null || true)
    fi
    [[ -n "$val" ]] && echo "$val" && return 0
    _conf_get "$section" "$key" "$SYS_CONF" 2>/dev/null || true
}

_conf_source() {
    local section="$1" key="$2" val=""
    if [[ -f "$USER_CONF" ]]; then
        val=$(_conf_get "$section" "$key" "$USER_CONF" 2>/dev/null || true)
        [[ -n "$val" ]] && echo "user" && return 0
    fi
    echo "system"
}

# ─────────────────────────────────────────────────────────────────────────────
#  version
# ─────────────────────────────────────────────────────────────────────────────

cmd_version() {
    local json=false
    [[ "${1:-}" == "--json" ]] && json=true

    if $json; then
        printf '{"version":"%s","phase":%s,"system":"DimArch OS"}\n' "$VERSION" "$PHASE"
    else
        echo "dimarchctl $VERSION — DimArch OS  [Phase $PHASE]"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
#  health --core
# ─────────────────────────────────────────────────────────────────────────────

cmd_health() {
    local json=false
    for arg in "$@"; do [[ "$arg" == "--json" ]] && json=true; done

    local -a ids labels statuses details
    local pass=0 fail=0 warn=0

    _check() {
        local id="$1" label="$2" status="$3" detail="${4:-}"
        ids+=("$id"); labels+=("$label"); statuses+=("$status"); details+=("$detail")
        case "$status" in
            pass) pass=$((pass+1)) ;;
            fail) fail=$((fail+1)) ;;
            warn) warn=$((warn+1)) ;;
        esac
    }

    # 1. /etc/dimarch.conf
    if [[ -f "$SYS_CONF" ]]; then
        _check sys_conf "/etc/dimarch.conf exists" pass
    else
        _check sys_conf "/etc/dimarch.conf exists" fail "file not found"
    fi

    # 2. swapfile exists on disk
    local swapfile
    swapfile=$(_conf_get_merged power swapfile_path)
    swapfile=${swapfile:-/home/.swapfile}
    if [[ -f "$swapfile" ]]; then
        _check swapfile_exists "swapfile exists ($swapfile)" pass
    else
        _check swapfile_exists "swapfile exists ($swapfile)" fail "not found — run setup-hibernate.sh"
    fi

    # 3. swapfile active in /proc/swaps
    if grep -q "^$swapfile " /proc/swaps 2>/dev/null; then
        _check swapfile_active "swapfile active in /proc/swaps" pass
    else
        _check swapfile_active "swapfile active in /proc/swaps" fail "not mounted — check /etc/fstab"
    fi

    # 4. GRUB has resume_offset=
    local grub_cmdline
    grub_cmdline=$(grep -E '^GRUB_CMDLINE_LINUX' /etc/default/grub 2>/dev/null || true)
    if echo "$grub_cmdline" | grep -q 'resume_offset='; then
        _check grub_resume "GRUB resume_offset configured" pass
    else
        _check grub_resume "GRUB resume_offset configured" fail "missing in /etc/default/grub"
    fi

    # 5. sudoers hibernate rule (check via sudo -ln — file not readable without root)
    if sudo -ln 2>/dev/null | grep -q 'hibernate.target'; then
        _check sudoers_hibernate "sudoers hibernate rule present" pass
    else
        _check sudoers_hibernate "sudoers hibernate rule present" fail "run: sudo setup-hibernate.sh"
    fi

    # 6. dimarch-sleep executable
    if command -v dimarch-sleep &>/dev/null; then
        _check dimarch_sleep "dimarch-sleep in PATH" pass
    else
        _check dimarch_sleep "dimarch-sleep in PATH" fail "not found — deploy install/utils/dimarch-sleep"
    fi

    # 7. dimarch-monitor executable
    if command -v dimarch-monitor &>/dev/null; then
        _check dimarch_monitor "dimarch-monitor in PATH" pass
    else
        _check dimarch_monitor "dimarch-monitor in PATH" fail "not found — deploy install/utils/dimarch-monitor"
    fi

    # 8. hypridle running (session check)
    if pgrep -x hypridle &>/dev/null; then
        _check hypridle_running "hypridle running" pass
    else
        _check hypridle_running "hypridle running" warn "not running — ok outside Hyprland session"
    fi

    # 9. hypridle.conf generated
    local hypridle_conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hypridle.conf"
    if [[ -f "$hypridle_conf" ]]; then
        _check hypridle_conf "hypridle.conf generated" pass
    else
        _check hypridle_conf "hypridle.conf generated" fail "run: dimarchctl power apply"
    fi

    # 10. user dimarch.conf
    if [[ -f "$USER_CONF" ]]; then
        _check user_conf "user config exists ($USER_CONF)" pass
    else
        _check user_conf "user config exists ($USER_CONF)" warn "optional — system defaults used"
    fi

    if $json; then
        local out i
        out='{"checks":['
        for i in "${!ids[@]}"; do
            [[ $i -gt 0 ]] && out+=','
            out+=$(printf '{"id":"%s","status":"%s","label":"%s","detail":"%s"}' \
                "${ids[$i]}" "${statuses[$i]}" "${labels[$i]}" "${details[$i]}")
        done
        out+=$(printf '],"summary":{"pass":%d,"fail":%d,"warn":%d}}' "$pass" "$fail" "$warn")
        if command -v jq &>/dev/null; then
            printf '%s\n' "$out" | jq .
        else
            printf '%s\n' "$out"
        fi
    else
        local i
        for i in "${!ids[@]}"; do
            case "${statuses[$i]}" in
                pass) printf '[PASS] %s\n' "${labels[$i]}" ;;
                fail) printf '[FAIL] %s — %s\n' "${labels[$i]}" "${details[$i]}" ;;
                warn) printf '[WARN] %s — %s\n' "${labels[$i]}" "${details[$i]}" ;;
            esac
        done
        echo ""
        printf '%d passed, %d failed, %d warning(s)\n' "$pass" "$fail" "$warn"
        return $([[ $fail -gt 0 ]] && echo 1 || echo 0)
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
#  display status  (Phase 0 stub)
# ─────────────────────────────────────────────────────────────────────────────

cmd_display_status() {
    local json=false
    [[ "${1:-}" == "--json" ]] && json=true

    if $json; then
        printf '{"status":"not_implemented","phase":"0"}\n'
    else
        echo "dimarchctl display status — not yet implemented (Phase 0)"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
#  power status
# ─────────────────────────────────────────────────────────────────────────────

cmd_power_status() {
    local json=false
    [[ "${1:-}" == "--json" ]] && json=true

    local lock_t mon_t hib_t sleep_mode monitor_off
    lock_t=$(_conf_get_merged power lock_timeout);        lock_t=${lock_t:-300}
    mon_t=$(_conf_get_merged power monitor_off_timeout);  mon_t=${mon_t:-420}
    hib_t=$(_conf_get_merged power hibernate_timeout);    hib_t=${hib_t:-1200}
    sleep_mode=$(_conf_get_merged power sleep_mode);      sleep_mode=${sleep_mode:-suspend}
    monitor_off=$(_conf_get_merged power monitor_off);    monitor_off=${monitor_off:-none}

    local src_lock src_mon src_hib
    src_lock=$(_conf_source power lock_timeout)
    src_mon=$(_conf_source power monitor_off_timeout)
    src_hib=$(_conf_source power hibernate_timeout)

    local user_exists=false
    [[ -f "$USER_CONF" ]] && user_exists=true

    if $json; then
        printf '{
  "sleep_mode": "%s",
  "monitor_off": "%s",
  "lock_timeout": %s,
  "monitor_off_timeout": %s,
  "hibernate_timeout": %s,
  "sources": {
    "lock_timeout": "%s",
    "monitor_off_timeout": "%s",
    "hibernate_timeout": "%s"
  },
  "user_conf_exists": %s,
  "user_conf": "%s"
}\n' \
            "$sleep_mode" "$monitor_off" \
            "$lock_t" "$mon_t" "$hib_t" \
            "$src_lock" "$src_mon" "$src_hib" \
            "$user_exists" "$USER_CONF"
    else
        printf '  sleep mode      : %s\n'       "$sleep_mode"
        printf '  monitor off     : %s\n'       "$monitor_off"
        printf '  lock timeout    : %ss (%s min)  [%s]\n' "$lock_t" "$((lock_t / 60))"  "$src_lock"
        printf '  monitor timeout : %ss (%s min)  [%s]\n' "$mon_t"  "$((mon_t  / 60))"  "$src_mon"
        printf '  hibernate       : %ss (%s min)  [%s]\n' "$hib_t"  "$((hib_t  / 60))"  "$src_hib"
        echo ""
        if $user_exists; then
            printf '  user config     : %s\n' "$USER_CONF"
        else
            printf '  config          : %s  (no user override)\n' "$SYS_CONF"
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
#  power apply
# ─────────────────────────────────────────────────────────────────────────────

cmd_power_apply() {
    local gen
    if command -v dimarch-hypridle-gen &>/dev/null; then
        gen="$(command -v dimarch-hypridle-gen)"
    else
        gen="$(dirname "$(realpath "$0")")/dimarch-hypridle-gen"
    fi

    [[ -x "$gen" ]] || {
        echo "dimarchctl: dimarch-hypridle-gen not found" >&2
        exit 1
    }

    exec "$gen"
}

# ─────────────────────────────────────────────────────────────────────────────
#  vpn status / up / down / toggle / ui
# ─────────────────────────────────────────────────────────────────────────────

_vpn_interface() {
    local iface
    iface=$(_conf_get_merged vpn interface)
    echo "${iface:-wg0}"
}

_vpn_active() {
    local iface="$1"
    nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx "$iface"
}

cmd_vpn_status() {
    local json=false
    [[ "${1:-}" == "--json" ]] && json=true

    local iface connected=false public_ip=""
    iface=$(_vpn_interface)
    _vpn_active "$iface" && connected=true

    if $connected; then
        public_ip=$(curl -s --max-time 2 ifconfig.io 2>/dev/null || true)
    fi

    if $json; then
        printf '{"interface":"%s","connected":%s,"public_ip":"%s"}\n' \
            "$iface" "$connected" "$public_ip"
    else
        if $connected; then
            printf '  VPN         : ON  (%s)\n' "$iface"
            [[ -n "$public_ip" ]] && printf '  Public IP   : %s\n' "$public_ip"
        else
            printf '  VPN         : OFF (%s)\n' "$iface"
        fi
    fi
}

cmd_vpn_up() {
    local iface; iface=$(_vpn_interface)
    nmcli connection up "$iface" >/dev/null
    echo "VPN ON"
}

cmd_vpn_down() {
    local iface; iface=$(_vpn_interface)
    nmcli connection down "$iface" >/dev/null
    echo "VPN OFF"
}

cmd_vpn_toggle() {
    local iface; iface=$(_vpn_interface)
    if _vpn_active "$iface"; then
        cmd_vpn_down
    else
        cmd_vpn_up
    fi
}

# Opens the WireGuard admin UI (tunnel mode: idempotent SSH port-forward + browser;
# direct mode: just opens admin_ui_url). Config: dimarch.conf [vpn].
cmd_vpn_ui() {
    local mode port
    mode=$(_conf_get_merged vpn admin_ui_mode); mode=${mode:-tunnel}
    port=$(_conf_get_merged vpn admin_ui_port); port=${port:-51821}

    if [[ "$mode" == "direct" ]]; then
        local url; url=$(_conf_get_merged vpn admin_ui_url)
        [[ -z "$url" ]] && { echo "dimarchctl: vpn.admin_ui_url is not set" >&2; exit 1; }
        xdg-open "$url" &>/dev/null &
        echo "Opening ${url}"
        return
    fi

    local host; host=$(_conf_get_merged vpn ssh_host)
    [[ -z "$host" ]] && { echo "dimarchctl: vpn.ssh_host is not set" >&2; exit 1; }

    if ss -ltn 2>/dev/null | grep -q ":${port} "; then
        echo "Tunnel already up"
    else
        # Explicit -L: don't assume ~/.ssh/config has a LocalForward for this
        # host — it's a personal file outside the repo and may not have one.
        ssh -f -N -L "${port}:localhost:${port}" "$host"
        echo "Tunnel started via ${host} (-L ${port}:localhost:${port})"
    fi

    xdg-open "http://localhost:${port}" &>/dev/null &
    echo "Opening http://localhost:${port}"
}

# ─────────────────────────────────────────────────────────────────────────────
#  Usage
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
Usage: dimarchctl <command> [subcommand] [--json]

Commands:
  version               DimArch OS version
  health [--core]       System health check (10 core checks, --core is default)
  display status        Monitor layout status (Phase 0 — stub)
  power status          Current power/idle timeout settings
  power apply           Regenerate hypridle.conf from template + config
  vpn status            WireGuard connection status (+ public IP when on)
  vpn up|down|toggle    Connect/disconnect the VPN
  vpn ui                Open the WireGuard admin UI (tunnel or direct, see dimarch.conf)

To change idle timeouts:
  1. Edit ~/.config/dimarch/dimarch.conf  (or /etc/dimarch.conf)
  2. Run: dimarchctl power apply

VPN setup: sudo install/utils/setup-wireguard.sh (reads dimarch.conf [vpn])

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
#  Main dispatch
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    version) cmd_version "${@:2}" ;;
    health)  cmd_health  "${@:2}" ;;
    display)
        case "${2:-}" in
            status) cmd_display_status "${@:3}" ;;
            *) echo "Usage: dimarchctl display status [--json]" >&2; exit 1 ;;
        esac
        ;;
    power)
        case "${2:-}" in
            status) cmd_power_status "${@:3}" ;;
            apply)  cmd_power_apply ;;
            *) echo "Usage: dimarchctl power <status|apply> [--json]" >&2; exit 1 ;;
        esac
        ;;
    vpn)
        case "${2:-}" in
            status) cmd_vpn_status "${@:3}" ;;
            up)     cmd_vpn_up ;;
            down)   cmd_vpn_down ;;
            toggle) cmd_vpn_toggle ;;
            ui)     cmd_vpn_ui ;;
            *) echo "Usage: dimarchctl vpn <status|up|down|toggle|ui> [--json]" >&2; exit 1 ;;
        esac
        ;;
    *) usage; exit ${1:+1} ;;
esac
