# =========================================================
# DimArch OS — Ghostty config
# DimArch Sage / Hyprland floating desktop
# =========================================================

# ---------------------------------------------------------
# Font
# ---------------------------------------------------------

font-family = JetBrainsMono Nerd Font
font-size = 12

# New windows/tabs always use the configured font size.
window-inherit-font-size = false

# ---------------------------------------------------------
# Colors
# ---------------------------------------------------------

# 2026-07-26: tried a full green-leaning near-black (181e1a), reverted as an
# overcorrection, then split the difference — halved the blue-over-green gap
# instead of flipping it. Same halved-gap nudge applied to waybar's
# bg_panel/bg_panel_bottom (style.css) so the two stay in the same family.
# Later the same day both went the rest of the way to hue 180 (G == B):
# terminal 171a1b -> 171b1b, panel 13,23,25 -> 13,25,25. Not visible side by
# side at this saturation — taken so one hue governs every surface.
background = 171b1b
foreground = edeae4

# Bumped from Ghostty's 0.5 default. Turned out NOT to be the fix for
# Claude Code's near-invisible diff comments (see palette 8 below) — that
# text is colored, not faint-attributed. Left slightly above default anyway
# since it's a reasonable value for whatever else does use real SGR faint.
faint-opacity = 0.75

# Selection
selection-background = 3f7a63
selection-foreground = edeae4

# Cursor
cursor-style = bar
cursor-style-blink = false
cursor-opacity = 0.7
adjust-cursor-thickness = 7
cursor-color = 7fb89e
cursor-text = 171b1b

# ANSI 16 colors — DimArch Sage. Generated from colors/palette.json; every
# slot resolves to a named role there, do not hand-edit a value here without
# changing it at the source first.
# blue (4/12) — history in two steps. First moved off blue-grey onto sage
# #6ba88c 2026-07-26, because Claude Code's inline markdown code has no theme
# token of its own and renders via raw ANSI bright-blue; global blast radius,
# accepted deliberately. That fixed "too blue" but created a worse problem:
# blue at 152 deg and green at 153 deg were the SAME hue, so the terminal had
# two colour slots carrying one colour, and directories stopped separating
# from executables. Now lichen #91b06d (88 deg) — 65 deg of separation without
# reintroducing a cold hue, which the palette rejects outright. See
# dimarch-theme/colors/palette.json.
palette = 0=#1f2424
palette = 1=#d96c6c
palette = 2=#7fb89e
palette = 3=#d4a96a
palette = 4=#91b06d
palette = 5=#b87a95
palette = 6=#7fb8b4
palette = 7=#c8c4be
# 8 (bright black) brightened from #3a3a4a 2026-07-26 — Claude Code renders
# comments/secondary diff text in this exact color (confirmed by pixel
# sampling), and the old value was too close to the terminal background to
# read. This is the actual fix; the faint-opacity change above was a wrong
# guess, kept only because it's harmless. Raised again the same day, #75757f
# -> #82828c: the first fix landed at 3.99:1, still under AA for text. The
# old value survives as neutral.disabled for non-text use.
palette = 8=#82828c
palette = 9=#e49393
palette = 10=#c4ddd2
palette = 11=#e4ba7a
palette = 12=#afc992
palette = 13=#cd98af
palette = 14=#8fccc8
palette = 15=#edeae4

# ---------------------------------------------------------
# Window appearance
# ---------------------------------------------------------

# Let Hyprland handle frame, border, shadow and rounding.
window-decoration = none

# Initial window size in terminal grid cells.
# Requested size: 145 columns × 45 rows.
window-width = 145
window-height = 45

# Comfortable internal padding.
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

# Transparency. Ghostty's own background-blur is a no-op on Hyprland
# (Ghostty docs: supported only on macOS and KDE Plasma/KWin) — actual
# window blur comes from Hyprland's compositor-level decoration.blur
# (~/.config/hypr/modules/decoration.lua, size=8/passes=2, applied
# globally to all windows, not per-app).
background-opacity = 0.85

# Use Ghostty terminal colors for the GTK window surface on Linux.
window-theme = ghostty

# window-save-state is macOS-only for now.
# On Linux it has no effect, so Hyprland controls window persistence.
# window-save-state = always

# ---------------------------------------------------------
# Behavior
# ---------------------------------------------------------

scrollback-limit = 100000

mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.2

copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

confirm-close-surface = false

# Native shell integration if available.
shell-integration = detect

# Hide visual scrollbar.
# Scrolling still works with mouse wheel, touchpad and keybinds.
scrollbar = never

# ---------------------------------------------------------
# Bell / notifications
# ---------------------------------------------------------

# Disable terminal bell noise and attention effects.
bell-features = no-audio,no-system,no-attention,no-title,no-border

# Disable clipboard-copy toast, keep config reload notifications.
app-notifications = no-clipboard-copy

# ---------------------------------------------------------
# Keybindings
# ---------------------------------------------------------

# Reload Ghostty config.
# Official default on Linux is Ctrl+Shift+Comma.
keybind = ctrl+shift+comma=reload_config

# Extra reload shortcut, usually conflict-free.
keybind = ctrl+shift+f5=reload_config

# New window / tab / splits
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down

# Close current surface: window / tab / split
keybind = ctrl+shift+w=close_surface

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
