# =========================================================
# DimArch OS — Hypridle (generated from hypridle.conf.tmpl)
# Idle / lock / monitor off / suspend
# Hyprland v0.55+ (dimarch-monitor, never dpms/wlopm directly)
#
# Timeout values come from dimarch.conf [power]:
#   lock_timeout         = ${LOCK_TIMEOUT}
#   monitor_off_timeout  = ${MONITOR_OFF_TIMEOUT}
#   hibernate_timeout    = ${HIBERNATE_TIMEOUT}
#
# To change timeouts:
#   1. Edit ~/.config/dimarch/dimarch.conf  (or /etc/dimarch.conf)
#   2. Run: dimarchctl power apply
# =========================================================

general {
    # Lock command.
    # Forces EN layout before starting hyprlock to avoid
    # getting stuck in RU layout on the lock screen.
    # With kb_layout = "us,ru":
    #   0 = us
    #   1 = ru
    lock_cmd = pidof hyprlock || sh -c 'hyprctl switchxkblayout all 0 >/dev/null 2>&1; hyprlock'

    # Before real suspend:
    # 1. save current floating window geometry
    # 2. lock session (always, regardless of caffeine state)
    #
    # Note: before_sleep_cmd fires on any PrepareForSleep signal
    # from systemd-logind — it is NOT subject to idle inhibitors.
    # This is intentional: the screen should always lock before sleep.
    before_sleep_cmd = sh -c '~/.config/hypr/scripts/save-before-sleep.sh; loginctl lock-session'

    # After real resume from suspend:
    # 1. ensure monitors are on (via dimarch-monitor, reads dimarch.conf)
    # 2. restore monitor layout and exact floating window geometry
    after_sleep_cmd = sh -c 'dimarch-monitor on; ~/.config/hypr/scripts/restore-after-resume.sh'

    # Respect app/media/screen-share idle inhibitors.
    # false = DO respect inhibitors (default, correct).
    # Covers: Firefox, mpv, Steam, OBS, screen share, etc.
    # Also covers Waybar idle_inhibitor module (caffeine).
    ignore_dbus_inhibit    = false
    ignore_systemd_inhibit = false

    # Wait until hyprlock fully acquires the session lock
    # before allowing the system to actually sleep.
    # 3 = wait for wayland session-lock protocol confirmation.
    inhibit_sleep = 3
}

# ---------------------------------------------------------
# lock_timeout → lock screen
# ---------------------------------------------------------
listener {
    timeout = ${LOCK_TIMEOUT}

    on-timeout = loginctl lock-session
}

# ---------------------------------------------------------
# monitor_off_timeout → turn monitors off (via dimarch-monitor)
#
# dimarch-monitor reads /etc/dimarch.conf [power] monitor_off:
#   none    — no-op (safe default, works on all hardware)
#   wlopm   — wlopm --off/--on (most GPUs, NOT AMD GCN3/Polaris)
#   ddcutil — DDC-CI via I2C (hardware-level, GPU context untouched)
# ---------------------------------------------------------
listener {
    timeout = ${MONITOR_OFF_TIMEOUT}

    on-timeout = sh -c '~/.config/hypr/scripts/save-before-sleep.sh; dimarch-monitor off'

    on-resume  = sh -c 'dimarch-monitor on; ~/.config/hypr/scripts/restore-after-resume.sh'
}

# ---------------------------------------------------------
# hibernate_timeout → sleep (suspend or hibernate)
#
# dimarch-sleep reads /etc/dimarch.conf [power] sleep_mode:
#   suspend   — S3 suspend-to-RAM (default)
#   hibernate — suspend-to-disk (required for AMD RX 580 Polaris)
# ---------------------------------------------------------
listener {
    timeout = ${HIBERNATE_TIMEOUT}

    on-timeout = dimarch-sleep
}
