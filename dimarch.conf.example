# ================================================================
# DimArch OS — System Configuration
# ================================================================
# Copy to dimarch.conf and fill in your values:
#   cp dimarch.conf.example dimarch.conf
#
# dimarch.conf is gitignored — never commit hardware-specific data.
# Deploy to /etc/dimarch.conf via install scripts (or manually).
# ================================================================

[system]
hostname = myhostname
username = myuser

[gpu]
vendor = amd
# Uncomment for AMD GCN 3 / Polaris (RX 4xx/5xx series).
# Required before ROCm support lands in the driver.
# Remove or leave commented for RDNA/RDNA2+ and non-AMD GPUs.
# amd_gfx_version = 8.0.3

[boot]
# grub — DimArch bootloader, GRUB + grub-btrfs + snap-pac
bootloader = grub

# Set to true only if Windows is installed on this machine and GRUB should
# detect it via os-prober (dual-boot boot-menu entry). Off by default —
# installs os-prober and regenerates grub.cfg when enabled.
enable_windows_dualboot = false

[monitors]
# Hyprland output names. Check with: hyprctl monitors | grep Monitor
primary   = DP-1
secondary = DP-2

[desktop]
hyprland_scale_primary   = 1.0
hyprland_scale_secondary = 1.0

[power]
# Sleep mode used by dimarch-sleep (called by hypridle on idle timeout).
#
#   suspend   — S3 suspend-to-RAM (default, works on most hardware)
#   hibernate — suspend-to-disk via swapfile
#               Required for AMD RX 580 Polaris and hardware with
#               PCI CONFIG reset on S3 resume (GPU context loss).
#               Run install/utils/setup-hibernate.sh first.
#
sleep_mode = suspend

# Monitor power off method (called by hypridle on second idle timeout).
#
#   none    — no monitor off (safe default, works on all hardware)
#   wlopm   — wlopm --off/--on (most GPUs; NOT AMD GCN3/Polaris RX 4xx/5xx)
#   ddcutil — DDC-CI via I2C (hardware-level, GPU context untouched)
#             Requires: paru -S ddcutil; modprobe i2c-dev
#             Test first: ddcutil detect && ddcutil --display N getvcp D6
#             Not all monitors support DDC write (e.g. LG HDR 4K fails).
#
monitor_off = none

# Idle timeouts (seconds). Applied by: dimarchctl power apply
#
#   lock_timeout         — idle time before hyprlock activates
#   monitor_off_timeout  — idle time before monitors turn off (monitor_off must be != none)
#   hibernate_timeout    — idle time before dimarch-sleep runs
#
# Defaults: 300 / 420 / 1200  (5 min / 7 min / 20 min)
# Change here, then run: dimarchctl power apply
#
lock_timeout         = 300
monitor_off_timeout  = 420
hibernate_timeout    = 1200

# Swapfile path (only used when sleep_mode = hibernate).
# Must be on a real partition (not zram/tmpfs) with RAM+2G free space.
# setup-hibernate.sh auto-sizes based on detected RAM.
swapfile_path = /home/.swapfile

[vpn]
# WireGuard client — optional, off by default.
# Set to true only after you've downloaded your own config from your
# WireGuard admin UI (e.g. wg-easy) and placed it at wg_conf_path below.
# Then run: sudo install/utils/setup-wireguard.sh
enable = false

# NetworkManager connection name used by `dimarchctl vpn` and the Waybar
# tray module. wg-easy generated configs default to this — change only if
# you renamed the connection.
interface = wg0

# Path to the WireGuard config file. Contains private keys — never commit
# this file or copy it into the dimarch repo/dotfiles.
wg_conf_path = /etc/wireguard/wg0.conf

# Admin UI access (used by: dimarchctl vpn ui).
#   tunnel — admin UI is only reachable via SSH port-forward. `dimarchctl vpn ui`
#            opens it itself (ssh -L admin_ui_port:localhost:admin_ui_port) — you
#            only need a plain Host entry in ~/.ssh/config named ssh_host below,
#            no LocalForward required there.
#   direct — admin UI is reachable directly, e.g. behind your own reverse
#            proxy + TLS. Requires admin_ui_url below.
admin_ui_mode = tunnel
admin_ui_port = 51821
ssh_host      =
admin_ui_url  =
