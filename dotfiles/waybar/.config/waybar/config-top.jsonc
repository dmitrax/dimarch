// =========================================================
// DimArch OS — Waybar Top Panel
// System bar: logo / workspaces / title / stats / clock / power
// =========================================================
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "exclusive": true,
    "passthrough": false,
    "output": ["DP-1", "DP-2"],

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
	"group/stats",
        "custom/weather",
        "pulseaudio",
        "group/keyboard",
        "tray",
        "custom/vpn",
	"idle_inhibitor",
        "clock",
        "custom/power"
    ],

    // ── Stats group ────────────────────────────────────────
    "group/stats": { 
	"orientation": "horizontal",
	"modules": ["cpu", "memory", "temperature"]
    },

    // ── Logo ───────────────────────────────────────────────
    "custom/logo": {
        "format": "Arch",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    // ── Workspaces ─────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by": "number",
        "disable-scroll": true,
        "on-click": "~/.config/hypr/scripts/workspace-switch.sh {}",
        "persistent-workspaces": {
           "DP-1": [1, 2, 3, 4, 5],
           "DP-2": [6, 7]
        }
    },

    // ── Active window title ────────────────────────────────
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    // ── CPU ────────────────────────────────────────────────
    "cpu": {
        "interval": 2,
        "format": "{usage}% 󰻠",
        "tooltip": false
    },

    // ── Memory ────────────────────────────────────────────
    "memory": {
        "interval": 5,
        "format": " {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    // ── GPU temperature (RX 580 — hwmon3) ─────────────────
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 85,
        "format": "󰢮 {temperatureC}°",
        "format-critical": "󰢮 {temperatureC}°",
        "tooltip": false
    },

    // ── Weather ───────────────────────────────────────────
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "interval": 1800,
        "format": "{}",
        "tooltip": true
    },

    // ── Volume + Microphone ───────────────────────────────
    "pulseaudio": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon}  {format_source}",
        "format-muted": "󰝟  {format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "headset":   "󰋎",
            "default":   ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}\n{volume}%"
    },

    // ── Keyboard (layout + CapsLock, merged group) ────────
    // group/keyboard visually merges hyprland/language + keyboard-state into
    // one shared box (same trick as group/stats above for cpu/memory/temp) —
    // per user preference 2026-07-09, the CapsLock icon appears/disappears
    // inside the same frame as the layout label, not as its own separate pill.
    "group/keyboard": {
        "orientation": "horizontal",
        "modules": ["hyprland/language", "keyboard-state"]
    },

    "hyprland/language": {
        "format": "  {}",
        "format-en": "EN",
        "format-ru": "RU",
        "format-uk": "UA"
    },

    // ── CapsLock indicator ────────────────────────────────
    // Waybar's built-in keyboard-state module (waybar-keyboard-state(5)) reads
    // libevdev LED state directly — requires the user to be in the `input`
    // group (`sudo usermod -aG input <user>`, then reboot), otherwise this
    // silently shows nothing. device-path pinned to the physical keyboard's
    // stable by-path symlink (found live 2026-07-09: "Logitech Wireless
    // Keyboard", the only device with a `leds` handler in
    // /proc/bus/input/devices) rather than relying on "first valid device"
    // auto-pick, which could land on the wrong /dev/input/eventN after a
    // reboot or if another device is plugged in. Only capslock is enabled —
    // numlock/scrolllock weren't asked for. format-icons uses the SAME glyph
    // for locked/unlocked (previously "unlocked" was "" to collapse the
    // module to zero width) — that collapse changed #keyboard's total width,
    // which shifted every module to its left in the bar every time caps was
    // toggled (found live 2026-07-09 after reboot-testing this feature).
    // Fix: keep the glyph's width reserved at all times; style.css toggles
    // only its color (transparent when unlocked) via the locked/unlocked
    // classes waybar already applies, so the block's width never changes.
    "keyboard-state": {
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "capslock": {
                "locked": "⇪",
                "unlocked": "⇪"
            }
        },
        "device-path": "/dev/input/by-path/pci-0000:00:14.0-usb-0:10:1.1-event-kbd"
    },

    // ── WireGuard VPN ──────────────────────────────────────
    // Status polled from `dimarchctl vpn status --json` (see dimarch.conf [vpn]).
    // Click to toggle; signal 8 forces an immediate re-poll instead of waiting
    // for the interval, so the icon updates right after the click.
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/vpn-status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "dimarchctl vpn toggle >/dev/null && pkill -RTMIN+8 waybar",
        "tooltip": true
    },

    // ── System tray ───────────────────────────────────────
    "tray": {
        "spacing": 8,
        "icon-size": 16
    },

    // ── Clock ─────────────────────────────────────────────
    "clock": {
    	"interval": 1,
    	"format": "{:%H:%M:%S}",
    	"format-alt": "{:%A, %d %B}",
    	"tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    	"on-click": "mode"
    },

    // ── Idle inhibitor (caffeine) ─────────────────────────
    // Uses zwp_idle_inhibit_manager_v1 — native Wayland protocol.
    // hypridle fully respects this inhibitor.
    // Click to toggle: ON = system will not lock or suspend.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated":   "\uF0F4",
            "deactivated": "\uF0F4"
        },
        "tooltip-format-activated":   "Caffeine ON — idle inhibited",
        "tooltip-format-deactivated": "Caffeine OFF"
    },
    
    // ── Power menu ────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    }
}
