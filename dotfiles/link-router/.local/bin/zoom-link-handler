#!/bin/bash
# Converts a zoom.us join link (https://xxx.zoom.us/j/ID?pwd=...) into the
# zoommtg:// deep link and launches Zoom directly, skipping the browser hop.
# Falls back to opening the URL in Chromium if it doesn't match a join link.
url="$1"

if [[ "$url" =~ ^https?://([a-zA-Z0-9.-]*\.zoom\.us)/j/([0-9]+) ]]; then
    host="${BASH_REMATCH[1]}"
    confno="${BASH_REMATCH[2]}"
    pwd=$(grep -oP '(?<=[?&]pwd=)[^&]+' <<< "$url")
    if [[ -n "$pwd" ]]; then
        exec zoom "zoommtg://${host}/join?action=join&confno=${confno}&pwd=${pwd}"
    else
        exec zoom "zoommtg://${host}/join?action=join&confno=${confno}"
    fi
else
    exec chromium "$url"
fi
