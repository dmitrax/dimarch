// =========================================================
// DimArch OS — Waybar Top Panel
// System bar: logo / workspaces / title / stats / clock / power
// =========================================================
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "exclusive": true,
    "passthrough": false,
    "output": ["DP-1", "DP-2"],

    "modules-left": [
        "image",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
	"group/stats",
        "custom/weather",
        "pulseaudio",
        "group/keyboard",
        "tray",
        "custom/vpn",
	"idle_inhibitor",
        "custom/notification",
        "clock",
        "custom/power"
    ],

    // ── Stats group ────────────────────────────────────────
    "group/stats": { 
	"orientation": "horizontal",
	"modules": ["cpu", "memory", "temperature"]
    },

    // ── Logo ───────────────────────────────────────────────
    // Arch Linux mark, traced from the official icon-only SVG shipped by
    // the `filesystem` package (/usr/share/pixmaps/archlinux-logo.svg) —
    // only the fill color was changed (upstream blue #1793d1 → a deep
    // forest-sage #2f5041, same hue/saturation as @accent_dark #5e9f82 at
    // much lower lightness) to match the Sage palette, geometry is
    // untouched. Kept as a project asset (icons/archlinux-logo-sage.svg)
    // rather than pointed at the system file, since GTK's image module
    // can't recolor an arbitrary (non-symbolic) SVG via CSS — the color
    // has to be baked in. Rendered via GTK's built-in image module (not
    // custom/text) so it's a real vector logo. SVG loading is guaranteed
    // transitively (gtk3, a hard Waybar dependency, itself depends on
    // librsvg).
    "image": {
        "path": "~/.config/waybar/icons/archlinux-logo-sage.svg",
        "size": 26,
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    // ── Workspaces ─────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by": "number",
        "disable-scroll": true,
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/workspace-switch.sh {}",
        "persistent-workspaces": {
           "DP-1": [1, 2, 3, 4, 5],
           "DP-2": [6, 7]
        }
    },

    // ── Active window title ────────────────────────────────
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },

    // ── CPU ────────────────────────────────────────────────
    // Icon glyph pinned to a fixed sage (inline pango <span color=...>,
    // honored since Waybar renders format strings as markup by default —
    // "escape" defaults to false) — the number keeps following text_soft
    // in style.css and gets brighter with it, the icon deliberately does
    // not (user request 2026-07-11: text lighter, "graphical elements"
    // unchanged). #6ba88c is the text_soft value from the PREVIOUS
    // brightening pass, i.e. "as it already looked".
    "cpu": {
        "interval": 2,
        "format": "{usage}% <span color='#6ba88c'>󰻠</span>",
        "tooltip": false
    },

    // ── Memory ────────────────────────────────────────────
    "memory": {
        "interval": 5,
        "format": "<span color='#6ba88c'></span> {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    // ── GPU temperature (RX 580 — hwmon3) ─────────────────
    // format-critical's icon uses @urgent's literal hex (#d96c6c) instead
    // of the frozen sage — the critical state is a real thermal-safety
    // signal (see rx580-gpu-compute-stack notes on this hardware), and an
    // inline span color always overrides the CSS cascade, so leaving it
    // sage here would have silently defeated #stats #temperature.critical
    // turning the icon red.
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 85,
        "format": "<span color='#6ba88c'>󰢮</span> {temperatureC}°",
        "format-critical": "<span color='#d96c6c'>󰢮</span> {temperatureC}°",
        "tooltip": false
    },

    // ── Weather ───────────────────────────────────────────
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "interval": 1800,
        "format": "{}",
        "tooltip": true
    },

    // ── Volume + Microphone ───────────────────────────────
    "pulseaudio": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon}  {format_source}",
        "format-muted": "󰝟  {format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "headset":   "󰋎",
            "default":   ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}\n{volume}%"
    },

    // ── Keyboard (layout + CapsLock, merged group) ────────
    // group/keyboard visually merges hyprland/language + keyboard-state into
    // one shared box (same trick as group/stats above for cpu/memory/temp) —
    // per user preference 2026-07-09, the CapsLock icon appears/disappears
    // inside the same frame as the layout label, not as its own separate pill.
    "group/keyboard": {
        "orientation": "horizontal",
        "modules": ["hyprland/language", "keyboard-state"]
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "format-uk": "UA",
        "keyboard-name": "logitech-wireless-keyboard-pid:4023"
    },

    // ── CapsLock indicator ────────────────────────────────
    // Waybar's built-in keyboard-state module (waybar-keyboard-state(5)) reads
    // libevdev LED state directly — requires the user to be in the `input`
    // group (`sudo usermod -aG input <user>`, then reboot), otherwise this
    // silently shows nothing. device-path pinned to the physical keyboard's
    // stable by-path symlink (found live 2026-07-09: "Logitech Wireless
    // Keyboard", the only device with a `leds` handler in
    // /proc/bus/input/devices) rather than relying on "first valid device"
    // auto-pick, which could land on the wrong /dev/input/eventN after a
    // reboot or if another device is plugged in. Only capslock is enabled —
    // numlock/scrolllock weren't asked for. format-icons uses the SAME glyph
    // for locked/unlocked (previously "unlocked" was "" to collapse the
    // module to zero width) — that collapse changed #keyboard's total width,
    // which shifted every module to its left in the bar every time caps was
    // toggled (found live 2026-07-09 after reboot-testing this feature).
    // Fix: keep the glyph's width reserved at all times; style.css toggles
    // only its color (transparent when unlocked) via the locked/unlocked
    // classes waybar already applies, so the block's width never changes.
    "keyboard-state": {
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "capslock": {
                "locked": "⇪",
                "unlocked": "⇪"
            }
        },
        "device-path": "/dev/input/by-path/pci-0000:00:14.0-usb-0:10:1.1-event-kbd"
    },

    // ── WireGuard VPN ──────────────────────────────────────
    // Status polled from `dimarchctl vpn status --json` (see dimarch.conf [vpn]).
    // Click to toggle; signal 8 forces an immediate re-poll instead of waiting
    // for the interval, so the icon updates right after the click.
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/vpn-status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "dimarchctl vpn toggle >/dev/null && pkill -RTMIN+8 waybar",
        "tooltip": true
    },

    // ── System tray ───────────────────────────────────────
    "tray": {
        "spacing": 8,
        "icon-size": 16
    },

    // ── Notification center (swaync) ───────────────────────
    // swaync's own recommended waybar integration (README.md "Waybar
    // Example"): swaync-client -swb streams one JSON line per event with a
    // "class" field ("notification"/"none"/"dnd-notification"/etc.) that
    // Waybar applies as a CSS class on #custom-notification — styling is
    // handled purely via style.css (see the .notification/.dnd-notification/
    // etc. selector group there), same convention as idle_inhibitor/
    // custom-vpn's "accent when active" look, not inline pango markup.
    // Left-click opens/closes the history panel, right-click toggles DND.
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // ── Clock ─────────────────────────────────────────────
    "clock": {
    	"interval": 1,
    	"format": "{:%H:%M:%S}",
    	"format-alt": "{:%A, %d %B}",
    	"tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    	"on-click": "mode"
    },

    // ── Idle inhibitor (caffeine) ─────────────────────────
    // Uses zwp_idle_inhibit_manager_v1 — native Wayland protocol.
    // hypridle fully respects this inhibitor.
    // Click to toggle: ON = system will not lock or suspend.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated":   "\uF0F4",
            "deactivated": "\uF0F4"
        },
        "tooltip-format-activated":   "Caffeine ON — idle inhibited",
        "tooltip-format-deactivated": "Caffeine OFF"
    },
    
    // ── Power menu ────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    }
}
