# =========================================================
# DimArch OS — Ghostty config
# DimArch Sage / Hyprland floating desktop
# =========================================================

# ---------------------------------------------------------
# Font
# ---------------------------------------------------------

font-family = JetBrainsMono Nerd Font
font-size = 12

# New windows/tabs always use the configured font size.
window-inherit-font-size = false

# ---------------------------------------------------------
# Colors
# ---------------------------------------------------------

background = 16161c
foreground = edeae4

# Selection
selection-background = 2d4a40
selection-foreground = edeae4

# Cursor
cursor-style = bar
cursor-style-blink = false
cursor-opacity = 0.7
adjust-cursor-thickness = 7
cursor-color = 7fb89e
cursor-text = 16161c

# ANSI 16 colors — DimArch Sage
palette = 0=#1e1e26
palette = 1=#c47a7a
palette = 2=#7fb89e
palette = 3=#d4a96a
palette = 4=#7a9cc4
palette = 5=#a07fb8
palette = 6=#7fb8b4
palette = 7=#c8c4be
palette = 8=#3a3a4a
palette = 9=#d48a8a
palette = 10=#8fccae
palette = 11=#e4ba7a
palette = 12=#8aacd4
palette = 13=#b08fc8
palette = 14=#8fccc8
palette = 15=#edeae4

# ---------------------------------------------------------
# Window appearance
# ---------------------------------------------------------

# Let Hyprland handle frame, border, shadow and rounding.
window-decoration = none

# Initial window size in terminal grid cells.
# Requested size: 145 columns × 45 rows.
window-width = 145
window-height = 45

# Comfortable internal padding.
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

# Transparency + blur.
background-opacity = 0.88
background-blur = 15

# Use Ghostty terminal colors for the GTK window surface on Linux.
window-theme = ghostty

# window-save-state is macOS-only for now.
# On Linux it has no effect, so Hyprland controls window persistence.
# window-save-state = always

# ---------------------------------------------------------
# Behavior
# ---------------------------------------------------------

scrollback-limit = 100000

mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.2

copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

confirm-close-surface = false

# Native shell integration if available.
shell-integration = detect

# Hide visual scrollbar.
# Scrolling still works with mouse wheel, touchpad and keybinds.
scrollbar = never

# ---------------------------------------------------------
# Bell / notifications
# ---------------------------------------------------------

# Disable terminal bell noise and attention effects.
bell-features = no-audio,no-system,no-attention,no-title,no-border

# Disable clipboard-copy toast, keep config reload notifications.
app-notifications = no-clipboard-copy

# ---------------------------------------------------------
# Keybindings
# ---------------------------------------------------------

# Reload Ghostty config.
# Official default on Linux is Ctrl+Shift+Comma.
keybind = ctrl+shift+comma=reload_config

# Extra reload shortcut, usually conflict-free.
keybind = ctrl+shift+f5=reload_config

# New window / tab / splits
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down

# Close current surface: window / tab / split
keybind = ctrl+shift+w=close_surface

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
